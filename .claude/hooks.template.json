{
  "description": "MCP Parallel Orchestration hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOKS_PATH}}/mcp-cli-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOOKS_PATH}}/mcp-parallel-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
